{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/Mintform.tsx",
      "src/Mintform.css",
      "src/MintformBase.css",
      "src/index.ts",
      "src/core/**/*.ts",
      "src/demo/performance.tsx",
      "src/demo/performance.css",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "vite.config.ts",
      "package.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
