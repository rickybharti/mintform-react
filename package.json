{
  "name": "@rickybharti/mintform",
  "private": false,
  "version": "0.1.0",
  "description": "A tactile, customizable CSS 3D token component for React.",
  "keywords": [
    "react",
    "react-component",
    "css-3d",
    "coin",
    "token",
    "animation",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickybharti/mintform-react.git"
  },
  "bugs": {
    "url": "https://github.com/rickybharti/mintform-react/issues"
  },
  "homepage": "https://github.com/rickybharti/mintform-react#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "import": {
        "types": "./dist/mintform.css.d.ts",
        "default": "./dist/mintform.css"
      },
      "require": {
        "types": "./dist/mintform.css.d.cts",
        "default": "./dist/mintform.css"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "STACK.md",
    "TESTING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PUBLISHING-CHECKLIST.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:types",
    "build:library": "vite build",
    "build:types": "node scripts/build-types.mjs",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "check:style": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/verify-package.mjs",
    "test:size": "size-limit",
    "test:consumer": "node scripts/verify-consumers.mjs",
    "test:types": "publint && attw --pack . --exclude-entrypoints ./styles.css",
    "test:all": "npm run check && npm run test && npm run build && npm run test:size && npm run test:package",
    "test:release": "npm run test:all && npm run test:consumer && npm run test:types",
    "prepack": "npm run test:all"
  },
  "size-limit": [
    {
      "name": "ES module (gzip)",
      "path": "dist/index.js",
      "limit": "9 kB",
      "gzip": true
    },
    {
      "name": "CommonJS module (gzip)",
      "path": "dist/index.cjs",
      "limit": "8 kB",
      "gzip": true
    },
    {
      "name": "Styles (gzip)",
      "path": "dist/mintform.css",
      "limit": "2.25 kB",
      "gzip": true
    }
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.4.7",
    "@size-limit/file": "12.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "fast-check": "^4.5.3",
    "publint": "0.3.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "12.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  }
}
